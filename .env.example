NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
REMONET_DB_PATH=data/remonet.sqlite
REMONET_ALLOWED_ORIGIN=http://127.0.0.1:5173
REMONET_APP_ORIGIN=http://127.0.0.1:5173
REMONET_SEED_DEMO=true
# Optional server-only integration credential. Use a random secret of at least 32 characters.
# REMONET_API_TOKEN=
# REMONET_API_ORGANIZATION_IDS=org-demo
# Configure these only to bootstrap an empty non-demo database.
# REMONET_BOOTSTRAP_EMAIL=
# REMONET_BOOTSTRAP_PASSWORD=
# REMONET_BOOTSTRAP_DISPLAY_NAME=
# REMONET_BOOTSTRAP_ORGANIZATION_ID=org-remonet
# REMONET_BOOTSTRAP_ORGANIZATION_NAME=RemoNet Workspace

# Observations kept per device before older check results are pruned (default 200).
# REMONET_OBSERVATION_RETENTION=200
# Seconds after the last successful check before a device is reported Offline (default 300).
# REMONET_STALE_AFTER_SECONDS=300
# Collector: `simulator` (default in development) answers for hardware that does not exist; `off`
# (default elsewhere) collects nothing.
# REMONET_COLLECTOR=simulator
# Collector scheduling: per-check timeout, checks in flight at once, attempts per device per cycle.
# REMONET_CHECK_TIMEOUT_MS=3000
# REMONET_MAX_CONCURRENT_CHECKS=8
# REMONET_CHECK_ATTEMPTS=3
