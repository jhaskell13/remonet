{
  "name": "remonet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start:api": "node --env-file-if-exists=.env dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --tsBuildInfoFile node_modules/.cache/typescript/app.tsbuildinfo --pretty false && tsc -p tsconfig.server.json --noEmit --tsBuildInfoFile node_modules/.cache/typescript/server.tsbuildinfo --pretty false && tsc -p tsconfig.server.build.json --noEmit --tsBuildInfoFile node_modules/.cache/typescript/server-build.tsbuildinfo --pretty false && tsc -p tsconfig.test.json --noEmit --tsBuildInfoFile node_modules/.cache/typescript/test.tsbuildinfo --pretty false && tsc -p tsconfig.test.client.json --noEmit --tsBuildInfoFile node_modules/.cache/typescript/test-client.tsbuildinfo --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client",
    "test:coverage": "vitest run --coverage",
    "build:server": "tsc -p tsconfig.server.build.json --noEmit false && node scripts/copy-server-assets.mjs",
    "build": "npm run typecheck && vite build && npm run build:server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
